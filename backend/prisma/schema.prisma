generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  name            String?
  phone           String?          @unique
  email           String           @unique
  passwordHash    String
  role            Role             @default(RIDER)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  captainProfile  Captain?
  refreshSessions RefreshSession[]
  ridesAsRider    Ride[]           @relation("RideRider")
}

model Captain {
  id             String          @id @default(uuid())
  userId         String          @unique
  status         CaptainStatus   @default(OFFLINE)
  vehicleType    String
  vehicleNumber  String          @unique
  rating         Decimal?        @db.Decimal(3, 2)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  ridesAsCaptain Ride[]          @relation("RideCaptain")
  rejections     RideRejection[]
}

model Ride {
  id                 String          @id @default(uuid())
  riderId            String
  captainId          String?
  pickupLat          Decimal         @db.Decimal(9, 6)
  pickupLng          Decimal         @db.Decimal(9, 6)
  destinationLat     Decimal         @db.Decimal(9, 6)
  destinationLng     Decimal         @db.Decimal(9, 6)
  estimatedDistanceM Int?
  estimatedDurationS Int?
  estimatedFare      Decimal?        @db.Decimal(12, 2)
  finalFare          Decimal?        @db.Decimal(12, 2)
  status             RideStatus
  scheduledAt        DateTime?
  cancelledBy        String?
  cancellationReason String?
  cancelledAt        DateTime?
  assignedAt         DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  version            Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  captain            Captain?        @relation("RideCaptain", fields: [captainId], references: [id])
  rider              User            @relation("RideRider", fields: [riderId], references: [id])
  rejections         RideRejection[]

  @@index([riderId])
  @@index([captainId])
  @@index([status])
  @@index([scheduledAt])
}

model RideRejection {
  id        String   @id @default(uuid())
  rideId    String
  captainId String
  createdAt DateTime @default(now())
  captain   Captain  @relation(fields: [captainId], references: [id])
  ride      Ride     @relation(fields: [rideId], references: [id])

  @@unique([rideId, captainId])
}

model RefreshSession {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  RIDER
  ADMIN
  CAPTAIN
}

enum CaptainStatus {
  OFFLINE
  AVAILABLE
  ON_RIDE
}

enum RideStatus {
  SCHEDULED
  SEARCHING
  CAPTAIN_ASSIGNED
  CAPTAIN_ARRIVING
  CAPTAIN_ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
